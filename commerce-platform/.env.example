# Server-only — not NEXT_PUBLIC_. Nothing calls the backend from the
# browser in this phase; see docs/API_CONTRACT.md's unresolved-questions
# section for the actual open decision (BFF proxy vs. direct browser
# calls) that a later phase needs to make before that changes.
API_BASE_URL=http://localhost:8010

# Must match the backend's own MPESA_ENABLED (e-commerce-backend/.env) —
# this app has no endpoint to ask the backend at request time, since
# MPESA_ENABLED there is a single global setting, not per-business data.
# Default false: when in doubt, show the honest "we'll contact you to
# arrange payment" message rather than an M-Pesa form the backend will
# refuse. Set true only once the backend side is actually configured and
# a real sandbox/production round trip has been verified.
MPESA_ENABLED=false
